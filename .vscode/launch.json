{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "cargo": {
                "args": [
                    "build",
                    "--bin=cosmic-wallshift",
                    "--package=cosmic-wallshift"
                ],
                "filter": {
                    "name": "cosmic-wallshift",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "kill-cosmic-wallshift"
        },
        {
            "name": "Python: Dependency Updater",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/recheck_deps.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
