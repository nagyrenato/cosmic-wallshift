<component type="desktop-application">
  <id>io.github.nagyrenato.CosmicWallShift</id>
  <name>COSMIC WallShift</name>
  <summary>Automatically switch wallpaper on COSMIC theme changes</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      COSMIC WallShift is a small tray app I wrote for the COSMIC desktop that
      handles one thing: swapping your wallpaper whenever you toggle between Light
      and Dark mode. No polling, no timers — it uses inotify to watch the theme
      config file directly, so the switch is instant.
    </p>
    <p>
      Set a wallpaper for each theme, close the window, and it just runs quietly
      in the system tray. You can bring the window back at any time from the tray
      menu. The app prevents multiple instances of itself from running via a Unix
      socket lock.
    </p>
  </description>

  <launchable type="desktop-id">io.github.nagyrenato.CosmicWallShift.desktop</launchable>

  <url type="homepage">https://github.com/nagyrenato/cosmic-wallshift</url>
  <url type="bugtracker">https://github.com/nagyrenato/cosmic-wallshift/issues</url>
  <url type="vcs-browser">https://github.com/nagyrenato/cosmic-wallshift</url>

  <developer id="io.github.nagyrenato">
    <name>Renato Nagy</name>
  </developer>

  <update_contact>nagy.renato@hotmail.com</update_contact>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <categories>
    <category>Utility</category>
    <category>Settings</category>
  </categories>

  <keywords>
    <keyword>wallpaper</keyword>
    <keyword>theme</keyword>
    <keyword>dark mode</keyword>
    <keyword>light mode</keyword>
    <keyword>cosmic</keyword>
    <keyword>background</keyword>
  </keywords>

  <branding>
    <color type="primary" scheme_preference="light">#ff7043</color>
    <color type="primary" scheme_preference="dark">#3d2a6e</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.0" date="2026-03-01">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/nagyrenato/cosmic-wallshift/v0.1.0/res/screenshots/image.png</image>
      <caption>Settings window showing light and dark wallpaper selection</caption>
    </screenshot>
  </screenshots>
</component>
